<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up and transfer only Nudge's database. Everything
     else (plugin caches, scheduled-notification state) is rebuilt when
     the app starts. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/nudge.sqlite" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/nudge.sqlite" />
    </device-transfer>
</data-extraction-rules>
