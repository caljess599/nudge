          "sql": "CREATE TABLE IF NOT EXISTS \"rings\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"period_days\" INTEGER NOT NULL, CHECK (period_days > 0));"
