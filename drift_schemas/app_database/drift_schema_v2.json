      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"members\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"contact_key\" TEXT NOT NULL UNIQUE, \"cached_name\" TEXT NOT NULL, \"nickname\" TEXT NULL, \"ring_id\" INTEGER NOT NULL REFERENCES rings (id) ON DELETE RESTRICT, \"baseline_date\" INTEGER NOT NULL, \"last_contacted\" INTEGER NULL, \"snoozed_until\" INTEGER NULL, \"last_surfaced\" INTEGER NULL);"
